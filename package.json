{
  "name": "simulator",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": "22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "rm -rf public/workbox-* && next build && workbox injectManifest workbox-config.cjs",
    "start": "next start",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx && prettier --check \"src/**/*.{js,jsx,ts,tsx,css,md,json}\"",
    "format": "eslint src --ext .js,.jsx,.ts,.tsx --fix && prettier --write \"src/**/*.{js,jsx,ts,tsx,css,md,json}\"",
    "typecheck": "next typegen && tsc --noEmit --emitDeclarationOnly false --declaration false",
    "spellcheck": "cspell **/*.{md,ts,tsx}",
    "prebuild": "node -e \"const fs = require('fs'); const pkg = require('./package.json'); fs.writeFileSync('./public/version.json', JSON.stringify({ version: pkg.version }));\"",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@semaphore-protocol/group": "3.15.2",
    "@semaphore-protocol/identity": "3.15.2",
    "@semaphore-protocol/proof": "3.15.2",
    "@worldcoin/idkit-core": "1.5.0",
    "@worldcoin/nucleus": "0.2.16",
    "@zk-kit/incremental-merkle-tree": "1.1.0",
    "buffer": "6.0.3",
    "clsx": "2.1.1",
    "framer-motion": "14.12.0",
    "jsqr": "1.4.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-dropzone": "20.2.0",
    "react-hot-toast": "2.6.1",
    "snarkjs": "0.7.6",
    "styled-jsx": "5.1.7",
    "tailwind-merge": "2.6.0",
    "usehooks-ts": "3.1.1",
    "viem": "2.57.18",
    "yup": "1.7.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "9.39.5",
    "@modelcontextprotocol/client": "2.4.0",
    "@next/bundle-analyzer": "16.4.6",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/snarkjs": "0.7.9",
    "@typescript-eslint/eslint-plugin": "8.72.2",
    "@worldcoin/idkit-test-client": "npm:@worldcoin/idkit-core@4.6.0",
    "autoprefixer": "10.6.2",
    "cspell": "10.4.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-tailwindcss": "3.18.2",
    "postcss": "8.5.32",
    "prettier": "3.10.0",
    "prettier-plugin-organize-attributes": "1.0.0",
    "prettier-plugin-organize-imports": "4.3.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "workbox-cli": "7.4.1",
    "workbox-expiration": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1"
  }
}
